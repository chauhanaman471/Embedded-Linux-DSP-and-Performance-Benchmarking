
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Milestone 1",
            "type": "shell",
            "command": "/usr/bin/gcc",
            "args": [
                "-g",
                "-Wall",
                "-Wextra",
                "${workspaceFolder}/milestones/milestone_01/main.c",
                "-o",
                "${workspaceFolder}/milestones/milestone_01/main"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build Milestone 2",
            "type": "shell",
            "command": "/usr/bin/gcc",
            "args": [
                "-g",
                "-Wall",
                "-Wextra",
                "${workspaceFolder}/milestones/milestone_02/main.c",
                "-o",
                "${workspaceFolder}/milestones/milestone_02/main",
                "-lm"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}